{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heyitsberhan",
  // Berh3n@gmail.com's account, which owns heyitsberhan.com.
  "account_id": "b272c385ca2256f61f1e383869b264bc",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [
    { "pattern": "heyitsberhan.com", "custom_domain": true },
    { "pattern": "www.heyitsberhan.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
